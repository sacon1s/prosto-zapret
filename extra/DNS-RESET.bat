@echo off
rem Zapret Pro - reset DNS to DHCP (self-elevating)
net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0..\tools\dns.ps1" -Action reset
echo.
pause
exit /b 0
